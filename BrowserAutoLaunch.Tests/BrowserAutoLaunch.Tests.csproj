<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net8.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

		<RootNamespace>NoP77svk.AspNetCore.BrowserAutoLaunch.Tests</RootNamespace>
		<AssemblyName>NoP77svk.AspNetCore.BrowserAutoLaunch.Tests</AssemblyName>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\IsExternalInit.cs" Link="IsExternalInit.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="xunit.v3" Version="4.0.1" />
		<PackageReference Include="Microsoft.Testing.Platform" Version="2.4.1" />
		<PackageReference Include="Microsoft.Testing.Platform.MSBuild" Version="2.4.1" />
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
        
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<None Update="$(ProjectDir)/*_Data/**/*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BrowserAutoLaunch.Core\BrowserAutoLaunch.Core.csproj" />
	</ItemGroup>

</Project>
