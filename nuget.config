<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- Default Package Sources; works like the 'packageSources' section of NuGet.Config files. -->
	<!-- This collection cannot be deleted or modified but can be disabled/enabled by users. -->
	<packageSources>
		<clear />
		<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
		<add key="NoP77svk" value="https://nuget.pkg.github.com/nop77svk/index.json" />
	</packageSources>

	<packageSourceMapping>
		<packageSource key="NoP77svk">
			<package pattern="NoP77svk.*" />
		</packageSource>
		<packageSource key="nuget.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>

	<packageSourceCredentials>
		<NoP77svk>
			<add key="Username" value="anyone" />
			<add key="ClearTextPassword" value="%NOP77SVK.GITHUB_PKG_TOKEN%" />
		</NoP77svk>
	</packageSourceCredentials>
</configuration>
